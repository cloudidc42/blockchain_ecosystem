# ==============================================================================
# Blockchain Explorer - Environment Variables
# ==============================================================================
# Copy this file to .env and update values for your environment
# DO NOT commit .env file to git!

# ==============================================================================
# BLOCKCHAIN NODE
# ==============================================================================
# Ethereum Node RPC URL (for production use Geth, Alchemy, Infura, etc.)
ETH_NODE_URL=http://anvil:8545
# For production:
# ETH_NODE_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# ETH_NODE_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Chain ID (1=Mainnet, 11155111=Sepolia, 31337=Anvil)
CHAIN_ID=31337

# WebSocket URL (optional, for real-time updates)
ETH_WS_URL=ws://anvil:8545
# ETH_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_PROJECT_ID

# ==============================================================================
# DATABASE - PostgreSQL (OLTP)
# ==============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=blockchain_explorer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# For production, use strong password:
# POSTGRES_PASSWORD=your_strong_password_here

# Connection pool settings
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ==============================================================================
# DATABASE - ClickHouse (Analytics)
# ==============================================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=blockchain_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
# For production:
# CLICKHOUSE_PASSWORD=your_strong_password_here

# ==============================================================================
# CACHE - Redis
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis
# For production:
# REDIS_PASSWORD=your_strong_password_here

# Redis Database Numbers
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1

# Cache TTL (in seconds)
CACHE_TTL_BLOCKS=300        # 5 minutes
CACHE_TTL_TXS=600           # 10 minutes
CACHE_TTL_ADDRESSES=300     # 5 minutes
CACHE_TTL_STATS=60          # 1 minute

# ==============================================================================
# INDEXER
# ==============================================================================
# Starting block to index from (0 for genesis)
START_BLOCK=0

# Number of blocks to process in each batch
BATCH_SIZE=100

# Number of confirmations before considering a block final
CONFIRMATIONS=12

# Reorg detection depth
REORG_DEPTH=50

# Polling interval for new blocks (seconds)
POLL_INTERVAL=2

# Number of worker threads
WORKER_THREADS=4

# ==============================================================================
# API - Backend
# ==============================================================================
# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=your-secret-key-change-in-production-please
# Generate with: openssl rand -hex 32

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# JWT Settings (if using authentication)
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Key for admin operations (optional)
ADMIN_API_KEY=your-admin-api-key

# ==============================================================================
# FRONTEND - Next.js UI
# ==============================================================================
# API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Environment
NODE_ENV=development
# For production: NODE_ENV=production

# Public URL
NEXT_PUBLIC_URL=http://localhost:3000

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# ==============================================================================
# MONITORING - Prometheus & Grafana
# ==============================================================================
# Grafana Admin
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# For production, change this!

# Prometheus retention
PROMETHEUS_RETENTION=15d

# Alert Manager (optional)
ALERTMANAGER_URL=

# ==============================================================================
# LOGGING
# ==============================================================================
# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log Format: json, text
LOG_FORMAT=json

# Log Output: stdout, file, both
LOG_OUTPUT=stdout

# Log File Path (if LOG_OUTPUT includes file)
LOG_FILE_PATH=/var/log/blockchain-explorer/app.log

# ==============================================================================
# OPTIONAL SERVICES
# ==============================================================================
# Message Queue - Kafka/Redpanda (optional)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_BLOCKS=blockchain.blocks
KAFKA_TOPIC_TXS=blockchain.transactions
KAFKA_TOPIC_LOGS=blockchain.logs

# S3/MinIO for data archival (optional)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=blockchain-archive

# Sentry for error tracking (optional)
SENTRY_DSN=

# ==============================================================================
# DEVELOPMENT
# ==============================================================================
# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# Enable SQL query logging
SQL_ECHO=false

# ==============================================================================
# PRODUCTION
# ==============================================================================
# SSL/TLS
SSL_CERTFILE=
SSL_KEYFILE=

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# Security
ENABLE_CORS=true
ENABLE_RATE_LIMITING=true
ENABLE_API_KEY_AUTH=false

# Performance
MAX_WORKERS=4
WORKER_TIMEOUT=30
KEEP_ALIVE=5

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
FEATURE_GRAPHQL=false
FEATURE_WEBSOCKET=false
FEATURE_CONTRACT_VERIFICATION=false
FEATURE_NFT_METADATA=false
FEATURE_INTERNAL_TXS=false

# ==============================================================================
# METRICS & ANALYTICS
# ==============================================================================
# Export metrics to Prometheus
METRICS_ENABLED=true
METRICS_PORT=9000

# Application metrics
APP_METRICS_INTERVAL=30  # seconds

# Business metrics
BUSINESS_METRICS_ENABLED=true

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Always use strong passwords in production
# 2. Never commit .env file to version control
# 3. Rotate secrets regularly
# 4. Use environment-specific values for dev/staging/prod
# 5. Keep this .env.example updated when adding new variables
